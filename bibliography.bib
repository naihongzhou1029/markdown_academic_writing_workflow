@article{migdadiKnowledgeManagementProcesses2022,
  title = {Knowledge Management Processes, Innovation Capability and Organizational Performance},
  author = {Migdadi, Mahmoud Mohammad},
  year = 2022,
  month = jan,
  journal = {International Journal of Productivity and Performance Management},
  volume = {71},
