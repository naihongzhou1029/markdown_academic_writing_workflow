@article{leeIntegratedViewKnowledge2012,
  title = {An Integrated View of Knowledge Management for Performance},
  author = {Lee, Sangjae and Gon Kim, Byung and Kim, Hoyal},
  year = 2012,
  month = mar,
  journal = {Journal of Knowledge Management},
  volume = {16},
  number = {2},
  pages = {183--203},
